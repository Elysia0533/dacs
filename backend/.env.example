# Copy file nay thanh backend/.env va dien thong tin SMTP that.
# backend/.env da duoc git ignore, khong commit mat khau vao source.

VBOOK_HOST=127.0.0.1
VBOOK_PORT=8080
VBOOK_SECRET=change-this-secret-before-release
VBOOK_PUBLIC_BASE_URL=http://127.0.0.1:8080

# Bat buoc gui email that. Neu thieu SMTP, backend se bao loi thay vi in ma demo.
VBOOK_REQUIRE_SMTP=1

# Gmail: can App Password, khong dung mat khau dang nhap Gmail thong thuong.
VBOOK_SMTP_HOST=smtp.gmail.com
VBOOK_SMTP_PORT=587
VBOOK_SMTP_TLS=1
VBOOK_SMTP_USER=your_email@gmail.com
VBOOK_SMTP_PASS=your_16_character_app_password
VBOOK_SMTP_FROM=your_email@gmail.com

# Ma xac nhan het han sau 15 phut.
VBOOK_EMAIL_VERIFICATION_TTL=900
